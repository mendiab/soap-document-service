<wsdl:definitions
	xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
	xmlns:tns="http://example.com/document"
	xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
	xmlns:ns1="http://schemas.xmlsoap.org/soap/http" name="DocumentService"
	targetNamespace="http://example.com/document">
	<wsdl:types>
		<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
			xmlns:xmime="http://www.w3.org/2005/05/xmlmime"
			xmlns:tns="http://example.com/document"
			elementFormDefault="unqualified"
			targetNamespace="http://example.com/document" version="1.0">
			<xs:import namespace="http://www.w3.org/2005/05/xmlmime" />
			<xs:element name="MessageHeader" type="tns:MessageHeader" />
			<xs:element name="SubmitDocumentRequest"
				type="tns:SubmitDocumentRequestType" />
			<xs:element name="SubmitDocumentResponse"
				type="tns:SubmitDocumentResponseType" />
			<xs:element name="attachment" type="tns:attachment" />
			<xs:element name="submitDocument"
				type="tns:submitDocument" />
			<xs:element name="submitDocumentResponse"
				type="tns:submitDocumentResponse" />
			<xs:complexType name="submitDocument">
				<xs:sequence>
					<xs:element minOccurs="0" name="request"
						type="tns:SubmitDocumentRequestType" />
				</xs:sequence>
			</xs:complexType>
			<xs:complexType name="SubmitDocumentRequestType">
				<xs:sequence>
					<xs:element minOccurs="0" name="title" type="xs:string" />
					<xs:element minOccurs="0" name="description"
						type="xs:string" />
					<xs:element minOccurs="0" name="attachments">
						<xs:complexType>
							<xs:sequence>
								<xs:element maxOccurs="unbounded" minOccurs="0"
									name="attachment" type="tns:attachment" />
							</xs:sequence>
						</xs:complexType>
					</xs:element>
				</xs:sequence>
			</xs:complexType>
			<xs:complexType name="attachment">
				<xs:sequence>
					<xs:element minOccurs="0" name="filename"
						type="xs:string" />
					<xs:element minOccurs="0" name="mimeType"
						type="xs:string" />
					<xs:element minOccurs="0" name="content"
						type="xs:base64Binary"
						xmime:expectedContentTypes="application/octet-stream" />
				</xs:sequence>
			</xs:complexType>
			<xs:complexType name="MessageHeader">
				<xs:sequence>
					<xs:element minOccurs="0" name="messageId"
						type="xs:string" />
					<xs:element minOccurs="0" name="sender" type="xs:string" />
					<xs:element minOccurs="0" name="receiver"
						type="xs:string" />
					<xs:element minOccurs="0" name="sendDate"
						type="xs:string" />
				</xs:sequence>
			</xs:complexType>
			<xs:complexType name="submitDocumentResponse">
				<xs:sequence>
					<xs:element minOccurs="0" name="return"
						type="tns:SubmitDocumentResponseType" />
				</xs:sequence>
			</xs:complexType>
			<xs:complexType name="SubmitDocumentResponseType">
				<xs:sequence>
					<xs:element minOccurs="0" name="status" type="xs:string" />
					<xs:element minOccurs="0" name="reference"
						type="xs:string" />
				</xs:sequence>
			</xs:complexType>
		</xs:schema>
	</wsdl:types>
	<wsdl:message name="submitDocument">
		<wsdl:part element="tns:submitDocument" name="parameters">
		</wsdl:part>
		<wsdl:part element="tns:MessageHeader" name="MessageHeader">
		</wsdl:part>
	</wsdl:message>
	<wsdl:message name="submitDocumentResponse">
		<wsdl:part element="tns:submitDocumentResponse"
			name="parameters">
		</wsdl:part>
	</wsdl:message>
	<wsdl:portType name="DocumentServiceEndpoint">
		<wsdl:operation name="submitDocument">
			<wsdl:input message="tns:submitDocument"
				name="submitDocument">
			</wsdl:input>
			<wsdl:output message="tns:submitDocumentResponse"
				name="submitDocumentResponse">
			</wsdl:output>
		</wsdl:operation>
	</wsdl:portType>
	<wsdl:binding name="DocumentServiceSoapBinding"
		type="tns:DocumentServiceEndpoint">
		<soap:binding style="document"
			transport="http://schemas.xmlsoap.org/soap/http" />
		<wsdl:operation name="submitDocument">
			<soap:operation soapAction="" style="document" />
			<wsdl:input name="submitDocument">
				<soap:header message="tns:submitDocument"
					part="MessageHeader" use="literal">
				</soap:header>
				<soap:body parts="parameters" use="literal" />
			</wsdl:input>
			<wsdl:output name="submitDocumentResponse">
				<soap:body use="literal" />
			</wsdl:output>
		</wsdl:operation>
	</wsdl:binding>
	<wsdl:service name="DocumentService">
		<wsdl:port binding="tns:DocumentServiceSoapBinding"
			name="DocumentServiceEndpointPort">
			<soap:address
				location="http://localhost:8080/services/documents" />
		</wsdl:port>
	</wsdl:service>
</wsdl:definitions>